<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="SelectableTextStyle" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="OverlaySwitchStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
        <Setter Property="Padding" Value="5,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" BorderThickness="1"
                            BorderBrush="Transparent" CornerRadius="3" x:Name="FocusOutline">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Track" Width="24" Height="14" CornerRadius="7" BorderThickness="1"
                                    BorderBrush="{DynamicResource SecondaryBrush}" VerticalAlignment="Center">
                                <Ellipse x:Name="Thumb" Width="8" Height="8" Margin="2,0"
                                         HorizontalAlignment="Left" Fill="{DynamicResource SecondaryBrush}"/>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource SecondaryBackgroundBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusOutline" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="ChartElementPresetTemplate">
        <StackPanel>
            <UniformGrid Rows="1" Columns="4" Width="248" HorizontalAlignment="Left"
                         Margin="0,4,0,0" TextElement.Foreground="{DynamicResource PrimaryBrush}">
                <Border/>
                <TextBox Style="{StaticResource SelectableTextStyle}" Text="Curve" TextAlignment="Center" ToolTip="Altitude curve across the chart"/>
                <TextBox Style="{StaticResource SelectableTextStyle}" Text="Glyph" TextAlignment="Center" ToolTip="Object symbol on the scrub line"/>
                <TextBox Style="{StaticResource SelectableTextStyle}" Text="Name" TextAlignment="Center" ToolTip="Object name on the scrub line"/>
            </UniformGrid>
            <ItemsControl ItemsSource="{Binding Groups}"
                          Width="248" HorizontalAlignment="Left">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <UniformGrid Rows="1" Columns="4">
                            <TextBox Style="{StaticResource SelectableTextStyle}" Text="{Binding Name, Mode=OneWay}"
                                     Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <CheckBox Style="{StaticResource OverlaySwitchStyle}" HorizontalAlignment="Center"
                                      AutomationProperties.Name="{Binding Curve.Name}" ToolTip="{Binding Curve.Name}"
                                      IsChecked="{Binding Curve.Enabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource OverlaySwitchStyle}" HorizontalAlignment="Center"
                                      AutomationProperties.Name="{Binding Glyph.Name}" ToolTip="{Binding Glyph.Name}"
                                      IsChecked="{Binding Glyph.Enabled, Mode=TwoWay}"/>
                            <CheckBox Style="{StaticResource OverlaySwitchStyle}" HorizontalAlignment="Center"
                                      AutomationProperties.Name="{Binding Label.Name}" ToolTip="{Binding Label.Name}"
                                      IsChecked="{Binding Label.Enabled, Mode=TwoWay}"/>
                        </UniformGrid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Rise and set" FontWeight="SemiBold" Margin="0,5,0,0"/>
            <ItemsControl ItemsSource="{Binding RiseSetOptions}" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource OverlaySwitchStyle}" Content="{Binding Name}"
                                  AutomationProperties.Name="{Binding Name}" IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
