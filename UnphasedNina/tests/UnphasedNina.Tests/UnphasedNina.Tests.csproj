<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/UnphasedNina/UnphasedNina.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="NUnit" Version="4.4.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
  </ItemGroup>
  <!-- N.I.N.A.'s own manifest schema, vendored unmodified (build/vendor/PROVENANCE.md), so
       the publishing tests validate against the same schema the application uses. -->
  <ItemGroup>
    <Content Include="../../build/vendor/manifest.schema.json" Link="manifest.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
