<ResourceDictionary x:Class="Zakfo.Unphased.Features.settings.Resources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ninactrl="clr-namespace:NINA.CustomControlLibrary;assembly=NINA.CustomControlLibrary"
    xmlns:local="clr-namespace:Zakfo.Unphased.Features.settings">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/UnphasedNina;component/Features/ChartElementControls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="OptionsTemplate">
        <StackPanel Margin="10" MaxWidth="860" HorizontalAlignment="Left">

            <!-- The site. The boxes edit a draft: nothing is stored until Apply, so a
                 half-typed pair can no longer sit in the settings while the chart quietly
                 uses the profile instead. The boxes are pre-filled with whatever is in
                 effect, which is why they are no longer blank when a site exists.
                 UnitTextBox is N.I.N.A.'s own field (number plus a read-only unit); its
                 template sizes itself to its content, so the width is set here - otherwise
                 the pair stretches across the whole settings tab. -->
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Observatory location" FontWeight="Bold" FontSize="15" />
            <TextBox Style="{StaticResource SelectableTextStyle}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0"
                Text="Use your active N.I.N.A. profile or specify an alternative observing location. Coordinates are decimal degrees." />
            <Grid Margin="0,8,0,0" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Style="{StaticResource SelectableTextStyle}" Text="Latitude" VerticalAlignment="Center" />
                <ninactrl:UnitTextBox Grid.Column="1" Margin="8,0,0,0" Width="90" MaxLength="9" Unit="°"
                    VerticalAlignment="Center" ToolTip="Latitude, -90 to 90"
                    Text="{Binding Settings.SiteLatDraft, UpdateSourceTrigger=LostFocus}" />
                <TextBox Style="{StaticResource SelectableTextStyle}" Grid.Column="3" Text="Longitude" VerticalAlignment="Center" />
                <ninactrl:UnitTextBox Grid.Column="4" Margin="8,0,0,0" Width="90" MaxLength="9" Unit="°"
                    VerticalAlignment="Center" ToolTip="Longitude, -180 to 180"
                    Text="{Binding Settings.SiteLonDraft, UpdateSourceTrigger=LostFocus}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Apply location" Padding="8,2"
                    ToolTip="Store these two coordinates as this profile's pinned planner location"
                    Command="{Binding Settings.ApplySiteCommand}" />
                <Button Margin="8,0,0,0" Padding="8,2" Content="Use N.I.N.A. profile location"
                    ToolTip="Put the profile's astrometry coordinates in the boxes and stop pinning a location"
                    Command="{Binding Settings.ResetSiteCommand}" />
            </StackPanel>
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" Opacity="0.8"
                Text="{Binding Settings.SiteReadout, Mode=OneWay}" />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" FontStyle="Italic"
                Text="{Binding Settings.SiteNotice, Mode=OneWay}" />

            <!-- Which palette the chart paints with. Three buttons because there is one
                 setting behind them and no off for a palette: the night switch this
                 replaces had nowhere to put the third scheme. The same three buttons are on
                 the panel and they are the same command, so the two cannot disagree - the
                 readout at the end names the setting rather than the last click. Not
                 remembered between runs on purpose: night mode is what you want at 2am under
                 a torch, not what you want the next afternoon with the chart still open. A
                 file saved by an older build that had night mode on opens once on night.
                 The words on these buttons are the words in the description and the README;
                 the panel abbreviates them to fit 86 DIP and points here in its tooltip. -->
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Display palette" FontWeight="Bold" FontSize="15" Margin="0,16,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="N.I.N.A. theme" Padding="8,2"
                    ToolTip="A consistent appearance with the host application: the chart follows whatever palette you picked in N.I.N.A.'s settings"
                    Command="{Binding Settings.DefaultSchemeCommand}" />
                <Button Margin="8,0,0,0" Padding="8,2" Content="Night vision"
                    ToolTip="A red-toned display designed for use at the telescope - the panel follows it too. N.I.N.A.'s own eye button in the title bar is the app-wide version."
                    Command="{Binding Settings.NightSchemeCommand}" />
                <Button Margin="8,0,0,0" Padding="8,2" Content="High contrast"
                    ToolTip="Enhanced distinction between chart elements: navy chart, sun amber, moon pale blue, horizon teal, so the three curves stay apart by colour and not only by brightness. Chart only - the panel keeps your N.I.N.A. colours."
                    Command="{Binding Settings.EnhancedSchemeCommand}" />
                <TextBox Style="{StaticResource SelectableTextStyle}" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.8"
                    Text="{Binding Settings.SchemeName, Mode=OneWay, StringFormat=palette in effect: {0}}" />
            </StackPanel>

            <!-- The three roles the chart is read by. The swatch is the control: click it
                 and the colour dialog opens seeded with what the chart paints right now.
                 The exact value - the pick, or what the palette resolves to - is in the
                 tooltip. Hex stays settable through the settings object for anyone editing
                 the file by hand. -->
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Custom chart colours" FontWeight="Bold" FontSize="15" Margin="0,16,0,0" />
            <TextBox Style="{StaticResource SelectableTextStyle}" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,0"
                Text="Each swatch shows what the chart paints right now. Click one to change it; the chart then follows your colour instead of the palette." />
            <Grid Margin="0,8,0,0" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBox Style="{StaticResource SelectableTextStyle}" Text="Solar altitude" VerticalAlignment="Center" />
                <Button Grid.Column="1" Margin="8,0,0,0" Padding="4,3"
                    ToolTip="{Binding Settings.SunColorNote}"
                    Command="{Binding Settings.PickSunColorCommand}">
                    <Border Width="44" Height="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                        Background="{Binding Settings.SunColorBrush}" />
                </Button>

                <TextBox Style="{StaticResource SelectableTextStyle}" Grid.Row="2" Text="Lunar altitude" VerticalAlignment="Center" />
                <Button Grid.Row="2" Grid.Column="1" Margin="8,0,0,0" Padding="4,3"
                    ToolTip="{Binding Settings.MoonColorNote}"
                    Command="{Binding Settings.PickMoonColorCommand}">
                    <Border Width="44" Height="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                        Background="{Binding Settings.MoonColorBrush}" />
                </Button>

                <TextBox Style="{StaticResource SelectableTextStyle}" Grid.Row="4" Text="Horizon" VerticalAlignment="Center" />
                <Button Grid.Row="4" Grid.Column="1" Margin="8,0,0,0" Padding="4,3"
                    ToolTip="{Binding Settings.HorizonColorNote}"
                    Command="{Binding Settings.PickHorizonColorCommand}">
                    <Border Width="44" Height="12" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"
                        Background="{Binding Settings.HorizonColorBrush}" />
                </Button>
            </Grid>
            <Button Margin="0,8,0,0" Padding="8,2" HorizontalAlignment="Left"
                Content="Restore default colours"
                ToolTip="Clear every picked colour: sun and moon follow the N.I.N.A. palette again, the horizon returns to green"
                Command="{Binding Settings.ResetColorsCommand}" />

            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Default chart elements" FontWeight="Bold" FontSize="15" Margin="0,16,0,0"
                       Foreground="{DynamicResource PrimaryBrush}" />
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="These choices are saved automatically. The planner uses them on startup and when you click Default."
                       TextWrapping="Wrap" Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,0" />
            <ContentControl Content="{Binding Settings.ChartDefaults}" ContentTemplate="{StaticResource ChartElementPresetTemplate}" />
            <CheckBox Content="Custom horizon" IsChecked="{Binding Settings.ChartDefaults.CustomHorizon.Enabled, Mode=TwoWay}"
                      Style="{StaticResource OverlaySwitchStyle}"
                      Margin="0,3,0,0" HorizontalAlignment="Left" />

            <Border Height="1" Margin="0,16,0,16" Background="{DynamicResource BorderBrush}" />

            <!-- The three pillars. N.I.N.A. draws this plugin's own identity above its "Options"
                 caption - name, author, version, the featured image and the italic line taken from
                 the manifest - and a plugin template cannot reach above that caption, so the real
                 settings come first under Options and the three perspectives close the page, just
                 above About. Same words, same order and same three drawings as the repository
                 README and the release description, so the plugin, the page it lands on and the
                 documentation describe the thing the same way. The drawings are declared here as
                 plain Path geometry on a 64 x 64 canvas, stroked 2 with rounded caps and joins,
                 and painted with the theme's own foreground - no icon package, no image file, and
                 they scale without going soft. The same geometry is mirrored in
                 assets/pillars/*.svg for the README, and PillarIdentityTests fails if the two
                 drift apart. -->
            <TextBox Style="{StaticResource SelectableTextStyle}" FontSize="19" FontWeight="Bold"
                Foreground="{DynamicResource PrimaryBrush}"
                Text="Three perspectives. One view of the night." />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Lunar and planetary phases, first because the Moon can decide whether a night
                     is worth driving to: the Moon itself, the star it shares the sky with, the arc it
                     travels, and the horizon it rises and sets against. -->
                <Viewbox Grid.Row="0" Width="48" Height="48" VerticalAlignment="Top">
                    <Canvas Width="64" Height="64">
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M8 48 H56" />
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M26 13 A11 11 0 1 0 26 35 A8.5 8.5 0 1 1 26 13 Z" />
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M44 12 V20 M40 16 H48" />
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            StrokeDashArray="2 4"
                            Data="M8 42 C22 34 42 34 56 42" />
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="14,0,0,0">
                    <TextBox Style="{StaticResource SelectableTextStyle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                        Text="Lunar and planetary phases" />
                    <TextBox Style="{StaticResource SelectableTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap" Opacity="0.85"
                        Text="Explore the dynamic phases of the Moon, Mercury and Venus alongside their altitude curves. Identify periods when the Moon is below the horizon, assess potential moonlight interference and discover moon-free imaging opportunities." />
                    <TextBox Style="{StaticResource SelectableTextStyle}" Margin="0,4,0,0" FontStyle="Italic" Foreground="{DynamicResource SecondaryBrush}"
                        Text="Understand the Moon and inner planets." />
                </StackPanel>

                <!-- Astronomical darkness: a setting Sun, the twilight bands beneath it, and the
                     drop into darkness below the horizon. -->
                <Viewbox Grid.Row="2" Width="48" Height="48" VerticalAlignment="Top">
                    <Canvas Width="64" Height="64">
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M8 44 H56 M22 44 A10 10 0 0 1 42 44" />
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M32 31 V27 M22.8 34.8 L20 32 M41.2 34.8 L44 32" />
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M12 50 H26 M38 50 H52 M16 56 H24 M40 56 H48" />
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M32 45 V58 M27 53 L32 58 L37 53" />
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="14,0,0,0">
                    <TextBox Style="{StaticResource SelectableTextStyle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                        Text="Astronomical darkness" />
                    <TextBox Style="{StaticResource SelectableTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap" Opacity="0.85"
                        Text="Visualise the transition from daylight through civil, nautical and astronomical twilight into astronomical darkness. Easily identify when darkness begins, when it ends and how much dark imaging time is available throughout each night." />
                    <TextBox Style="{StaticResource SelectableTextStyle}" Margin="0,4,0,0" FontStyle="Italic" Foreground="{DynamicResource SecondaryBrush}"
                        Text="Understand the darkness." />
                </StackPanel>

                <!-- Multi-night visualisation: a calendar carrying three altitude curves, because what
                     this plugin compares from night to night is the shape of the sky, not a date. -->
                <Viewbox Grid.Row="4" Width="48" Height="48" VerticalAlignment="Top">
                    <Canvas Width="64" Height="64">
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M14 16 H50 A2 2 0 0 1 52 18 V50 A2 2 0 0 1 50 52 H14 A2 2 0 0 1 12 50 V18 A2 2 0 0 1 14 16 Z" />
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M20 11 V18 M44 11 V18 M12 24 H52" />
                        <Path Stroke="{DynamicResource PrimaryBrush}" StrokeThickness="2"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            Data="M16 46 Q20 31 24 46 M28 46 Q32 29 36 46 M40 46 Q44 31 48 46" />
                    </Canvas>
                </Viewbox>
                <StackPanel Grid.Row="4" Grid.Column="1" Margin="14,0,0,0">
                    <TextBox Style="{StaticResource SelectableTextStyle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"
                        Text="Multi-night visualisation" />
                    <TextBox Style="{StaticResource SelectableTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap" Opacity="0.85"
                        Text="Look beyond tonight and explore how astronomical darkness and the Moon evolve across consecutive nights. Compare upcoming nights and identify favourable windows for future astrophotography sessions." />
                    <TextBox Style="{StaticResource SelectableTextStyle}" Margin="0,4,0,0" FontStyle="Italic" Foreground="{DynamicResource SecondaryBrush}"
                        Text="Plan the nights ahead." />
                </StackPanel>
            </Grid>

            <Border Height="1" Margin="0,16,0,16" Background="{DynamicResource BorderBrush}" />

            <!-- The rest of the description, in the same words as the release description and
                 the README. Everything here is stated as it behaves today; the development
                 status says plainly that this is unfinished software. -->
            <TextBox Style="{StaticResource SelectableTextStyle}" Text="About Unphased Night Planner" FontWeight="Bold" FontSize="15" />

            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Interactive night planning" FontWeight="Bold" Margin="0,10,0,0" />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,4,0,0" TextWrapping="Wrap"
                     Text="-  Dynamic altitude chart for combined solar, lunar, planetary and deep-sky paths through the sky." />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,2,0,0" Text="-  Colour-coded daylight, twilight and astronomical darkness periods." />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,2,0,0" Text="-  Nighttime duration and astronomical darkness summaries." />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,2,0,0" Text="-  Lunar culmination and illumination indicators." />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,2,0,0" Text="-  Adjustable single-night and multi-night views." />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,2,0,0" Text="-  Integrated calendar with date navigation and instant return to tonight." />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,2,0,0" Text="-  Interactive time scrubber for inspecting conditions at specific times." />

            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Display and customisation" FontWeight="Bold" Margin="0,10,0,0" />
            <TextBox Style="{StaticResource SelectableTextStyle}" TextWrapping="Wrap" Opacity="0.85" Margin="10,4,0,0"
                Text="The planner integrates with N.I.N.A.'s native colour scheme and provides three display palettes:" />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,2,0,0" Text="-  N.I.N.A. theme - a consistent appearance with the host application." />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,2,0,0" Text="-  Night vision - a red-toned display designed for use at the telescope." />
            <TextBox Style="{StaticResource SelectableTextStyle}" Margin="10,2,0,0" Text="-  High contrast - enhanced visual distinction between chart elements." />
            <TextBox Style="{StaticResource SelectableTextStyle}" TextWrapping="Wrap" Opacity="0.85" Margin="10,4,0,0"
                Text="Individual chart colours for solar altitude, lunar altitude and the horizon can be customised through the plugin options." />

            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Observatory location" FontWeight="Bold" Margin="0,10,0,0" />
            <TextBox Style="{StaticResource SelectableTextStyle}" TextWrapping="Wrap" Opacity="0.85" Margin="10,4,0,0"
                Text="By default, astronomical conditions are calculated using the observatory location configured in the active N.I.N.A. profile." />
            <TextBox Style="{StaticResource SelectableTextStyle}" TextWrapping="Wrap" Opacity="0.85" Margin="10,4,0,0"
                Text="An optional manual location override allows you to explore nighttime conditions at alternative observing sites, making the planner useful for both local imaging and planning future astrophotography trips." />

            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Astronomical calculations" FontWeight="Bold" Margin="0,10,0,0" />
            <TextBox Style="{StaticResource SelectableTextStyle}" TextWrapping="Wrap" Opacity="0.85" Margin="10,4,0,0"
                Text="Solar and lunar ephemerides are calculated locally using the Astronomy Engine (CosineKitty/AstronomyEngine), based on the selected observing location." />
            <TextBox Style="{StaticResource SelectableTextStyle}" TextWrapping="Wrap" Opacity="0.85" Margin="10,4,0,0"
                Text="The planner visualises astronomical conditions independently of weather forecasts, atmospheric transparency and local light pollution." />

            <TextBox Style="{StaticResource SelectableTextStyle}" Text="Development status" FontWeight="Bold" Margin="0,10,0,0" />
            <TextBox Style="{StaticResource SelectableTextStyle}" TextWrapping="Wrap" Opacity="0.85" Margin="10,4,0,0"
                Text="Unphased Night Planner is under active development, with ongoing improvements to functionality, visualisation and the user experience." />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
